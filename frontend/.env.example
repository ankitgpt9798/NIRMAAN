# ---------------------------------------------------------------
# Frontend environment variables
# Copy this file to frontend/.env (optional for local development).
# Only variables starting with VITE_ are exposed to the browser,
# so NEVER put secrets here.
# ---------------------------------------------------------------

# Backend API base URL.
# Local development: leave empty - the Vite dev server forwards /api to the backend.
# Production (Vercel): your Render API URL, e.g. https://your-shop-api.onrender.com/api
VITE_API_URL=

# Local development only: where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:5000
