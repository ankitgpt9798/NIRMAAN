# ===============================================================
# Environment variable reference for the whole project.
# Placeholder values only - never put real secrets in this file.
#
# Each app reads its own file:
#   backend/.env   (copy from backend/.env.example)
#   frontend/.env  (copy from frontend/.env.example, optional locally)
# ===============================================================

# ---------- backend/.env ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nirmaan_catalogue
DNS_SERVERS=
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
TRUST_PROXY=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nirmaan
UPLOADS_DIR=

# ---------- frontend/.env ----------
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:5000
