{
  "name": "nirmaan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the building material shop price catalogue",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "db:check": "node --env-file-if-exists=.env scripts/checkDb.js",
    "cloudinary:check": "node --env-file-if-exists=.env scripts/checkCloudinary.js",
    "create-admin": "node --env-file-if-exists=.env scripts/createAdmin.js",
    "seed:categories": "node --env-file-if-exists=.env scripts/seedCategories.js",
    "test": "node --env-file-if-exists=.env --import ./tests/setup.js --test --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
