# ---------------------------------------------------------------
# Backend environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env - it contains secrets.
# ---------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# Replace <db_username>, <db_password> and the cluster address with your own.
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (automated tests use nirmaan_catalogue_test)
MONGODB_DB_NAME=nirmaan_catalogue
# Optional, local Windows fix: leave empty unless you see "querySrv ECONNREFUSED".
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1  (not needed on Render)
DNS_SERVERS=

# Long random secret used to sign admin login tokens (minimum 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
# Local: http://localhost:5173   Production: your Vercel URL, e.g. https://your-shop.vercel.app
CORS_ORIGINS=http://localhost:5173

# Permanent public website URL. The printed shop QR code encodes exactly this URL,
# so set it to the final production address before printing the QR code.
PUBLIC_SITE_URL=http://localhost:5173

# Number of proxies in front of the server (use 1 on Render, 0 locally)
TRUST_PROXY=0

# Optional: Cloudinary image storage (leave empty to store images on the server disk).
# Strongly recommended for production: Render's free disk is wiped on every restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary folder for this shop's images (product photos go to <folder>/products)
CLOUDINARY_FOLDER=nirmaan

# Optional: folder for images when Cloudinary is NOT configured (default: backend/uploads)
UPLOADS_DIR=
